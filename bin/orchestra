#!/usr/bin/env bash
# orchestra — bir kodlama görevini seviyesine uygun ucuz modele delege eder.
#
#   orchestra <basit|orta|zor> "<görev>"
#   orchestra basit "src/utils/date.ts içindeki formatDate'de tipo var, düzelt"
#
# Claude Code orchestrator olarak bu script'i çağırır; kodu ucuz model yazar,
# doğrulamayı ve review'ı Claude Code kendisi yapar.
set -euo pipefail

# ~/.local/bin/orchestra bir symlink olabilir; gerçek repo kökünü bulmak için zinciri çöz
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  TARGET="$(readlink "$SELF")"
  [[ "$TARGET" == /* ]] && SELF="$TARGET" || SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET"
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat >&2 <<'U'
Kullanım: orchestra <seviye> "<görev>"

Seviyeler:
x
  orta  | medium    DeepSeek V4.1 Flash                — thinking off
  zor   | hard      DeepSeek V4.1 Flash, thinking high

Seçenekler:
  --cwd <dir>       Çalışma dizini (varsayılan: mevcut dizin)
  --dry-run         Çalıştırmadan komutu yazdır
U
  exit 2
}

[[ $# -ge 1 ]] || usage

TIER=""; CWD="$PWD"; DRY=0; TASK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) CWD="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    *) if [[ -z "$TIER" ]]; then TIER="$1"; else TASK="${TASK:+$TASK }$1"; fi; shift ;;
  esac
done

[[ -n "$TASK" ]] || usage

case "$TIER" in
  basit|simple|1)
    MODEL="ollama/qwen3-local"; THINK="off"; AGENT="local-coder"
    TOOLS="read,grep,find,ls,edit,write"   # bash yok: 7B model + kabuk istenmez
    ;;
  orta|medium|2)
    MODEL="deepseek/deepseek-flash"; THINK="off"; AGENT="ds-worker"; TOOLS=""
    ;;
  zor|hard|3)
    MODEL="deepseek/deepseek-flash"; THINK="high"; AGENT="ds-architect"; TOOLS=""
    ;;
  *) echo "Bilinmeyen seviye: $TIER" >&2; usage ;;
esac

SYSFILE="$REPO/agents/$AGENT.md"
[[ -f "$SYSFILE" ]] || { echo "Agent tanımı yok: $SYSFILE" >&2; exit 1; }

# nvm kullanılıyorsa pi'nin gerektirdiği node sürümüne geç (pi-subagents >=22.19)
if ! command -v pi >/dev/null 2>&1 || [[ "$(node -e 'const[a,b]=process.versions.node.split(".");process.stdout.write(a+"."+String(b).padStart(3,"0"))' 2>/dev/null)" < "22.019" ]]; then
  # shellcheck disable=SC1090
  [[ -s "$HOME/.nvm/nvm.sh" ]] && . "$HOME/.nvm/nvm.sh" && nvm use default >/dev/null 2>&1 || true
fi
command -v pi >/dev/null || { echo "pi bulunamadı. install.sh çalıştır." >&2; exit 1; }

# YAML frontmatter'ı at, sistem promptu olarak gövdeyi kullan
SYSTEM="$(awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; next} n>=2' "$SYSFILE")"

# Sistem promptu modu katmana göre değişir:
#   BASİT  → replace. Lokal model gecikme darboğazı; pi'nin büyük varsayılan
#            promptunu işlemek 8B'de süreyi ikiye katlıyor (136s → 58s ölçüldü).
#            Qwen3 native tool_calls ürettiği için o scaffolding'e ihtiyaç yok.
#   ORTA/ZOR → append. Güçlü modellerde darboğaz gecikme değil kalite;
#            pi'nin dosya düzenleme ve proje bağlamı disiplini korunsun.
if [[ "$AGENT" == "local-coder" ]]; then
  ARGS=(-p --no-session --model "$MODEL" --thinking "$THINK" --system-prompt "$SYSTEM")
else
  ARGS=(-p --no-session --model "$MODEL" --thinking "$THINK" --append-system-prompt "$SYSTEM")
fi
[[ -n "$TOOLS" ]] && ARGS+=(--tools "$TOOLS")

if [[ $DRY -eq 1 ]]; then
  printf 'cwd=%s\nmodel=%s thinking=%s agent=%s tools=%s\n' "$CWD" "$MODEL" "$THINK" "$AGENT" "${TOOLS:-<hepsi>}"
  exit 0
fi

printf '\033[2m[orchestra] %s → %s (thinking=%s)\033[0m\n' "$AGENT" "$MODEL" "$THINK" >&2
cd "$CWD"

# Değişiklik öncesi durumu kaydet ki sonunda gerçekten ne değiştiğini gösterebilelim.
# Lokal model istenmeyen stil normalizasyonu yapmaya eğilimli; diff'i otomatik
# yazdırmak orchestrator'ın bunu gözden kaçırmasını engelliyor.
IS_GIT=0; git rev-parse --git-dir >/dev/null 2>&1 && IS_GIT=1

set +e
pi "${ARGS[@]}" "$TASK"
PI_STATUS=$?
set -e

if [[ $IS_GIT -eq 1 ]]; then
  CHANGED="$(git diff --stat 2>/dev/null | tail -1)"
  if [[ -n "$CHANGED" ]]; then
    printf '\n\033[1m[orchestra] değişiklikler:\033[0m %s\n' "$CHANGED" >&2
    git --no-pager diff >&2
    printf '\033[2m[orchestra] istenen değişiklik dışında satır varsa geri al: git checkout -p <dosya>\033[0m\n' >&2
  else
    printf '\n\033[33m[orchestra] hiçbir dosya değişmedi.\033[0m\n' >&2
  fi
fi

exit $PI_STATUS
