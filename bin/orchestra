#!/usr/bin/env bash
# orchestra — delegate a coding task to the cheapest model that can do it.
#
#   orchestra <simple|medium|hard> "<task>"
#   orchestra simple "Fix the typo in formatDate in src/utils/date.ts"
#
# Claude Code calls this as the orchestrator: the cheap model writes the code,
# Claude Code verifies and integrates it.
set -euo pipefail

# ~/.local/bin/orchestra may be a symlink; resolve the chain to find the repo root.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  TARGET="$(readlink "$SELF")"
  [[ "$TARGET" == /* ]] && SELF="$TARGET" || SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET"
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat >&2 <<'U'
Usage: orchestra <tier> "<task>"
       orchestra init [--cwd <dir>]

Tiers:
  simple    Qwen3 8B (local, $0)              — no bash, edits files only
  medium    DeepSeek V4.1 Flash               — thinking off
  hard      DeepSeek V4.1 Flash, thinking high

Options:
  --cwd <dir>       Working directory (default: current directory)
  --dry-run         Print the resolved configuration without running

init prepares a project so delegated models inherit its context:
  - CLAUDE.md / AGENTS.md are picked up automatically, nothing to do
  - .claude/skills is bridged into pi via .pi/settings.json
U
  exit 2
}

[[ $# -ge 1 ]] || usage

# ------------------------------------------------------------------ init
# pi reads CLAUDE.md and AGENTS.md on its own, but it looks for skills under
# .pi/skills and never sees .claude/skills. This points pi at the Claude Code
# skills directory so a delegated model gets the same project knowledge.
if [[ "$1" == "init" ]]; then
  shift
  TARGET="$PWD"
  [[ "${1:-}" == "--cwd" ]] && TARGET="$2"
  cd "$TARGET"

  echo "Project: $PWD"

  for f in CLAUDE.md AGENTS.md; do
    [[ -f "$f" ]] && echo "  ✓ $f found — inherited automatically"
  done
  [[ -f CLAUDE.md || -f AGENTS.md ]] || \
    echo "  ! no CLAUDE.md or AGENTS.md — delegated models will have no project context"

  if [[ -d .claude/skills ]]; then
    mkdir -p .pi
    if [[ -f .pi/settings.json ]]; then
      TMP="$(mktemp)"
      jq '.skills = ((.skills // []) + ["../.claude/skills"] | unique)' .pi/settings.json > "$TMP" \
        && mv "$TMP" .pi/settings.json
    else
      printf '{\n  "skills": ["../.claude/skills"]\n}\n' > .pi/settings.json
    fi
    COUNT="$(find .claude/skills -name SKILL.md -maxdepth 2 2>/dev/null | wc -l | tr -d ' ')"
    echo "  ✓ bridged $COUNT skill(s) from .claude/skills via .pi/settings.json"
  else
    echo "  · no .claude/skills directory — nothing to bridge"
  fi

  if [[ -d .git ]] && ! grep -qs '^\.pi/' .gitignore 2>/dev/null; then
    echo "  · consider committing .pi/settings.json so your team shares it"
  fi

  echo "Done. Run 'claude' here and work normally."
  exit 0
fi

TIER=""; CWD="$PWD"; DRY=0; TASK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) CWD="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    *) if [[ -z "$TIER" ]]; then TIER="$1"; else TASK="${TASK:+$TASK }$1"; fi; shift ;;
  esac
done

[[ -n "$TASK" ]] || usage

# Turkish aliases (basit/orta/zor) are accepted but undocumented.
case "$TIER" in
  simple|basit|1)
    MODEL="ollama/qwen3-local"; THINK="off"; AGENT="local-coder"
    TOOLS="read,grep,find,ls,edit,write"   # no bash: a small model plus a shell is a bad combination
    ;;
  medium|orta|2)
    MODEL="deepseek/deepseek-flash"; THINK="off"; AGENT="ds-worker"; TOOLS=""
    ;;
  hard|zor|3)
    MODEL="deepseek/deepseek-flash"; THINK="high"; AGENT="ds-architect"; TOOLS=""
    ;;
  *) echo "Unknown tier: $TIER" >&2; usage ;;
esac

SYSFILE="$REPO/agents/$AGENT.md"
[[ -f "$SYSFILE" ]] || { echo "Agent definition not found: $SYSFILE" >&2; exit 1; }

# Switch to the node version pi needs (>= 22.19) when nvm is in use.
if ! command -v pi >/dev/null 2>&1 || [[ "$(node -e 'const v=process.versions.node.split(".");process.stdout.write(v[0]+"."+String(v[1]).padStart(3,"0"))' 2>/dev/null)" < "22.019" ]]; then
  # shellcheck disable=SC1090
  [[ -s "$HOME/.nvm/nvm.sh" ]] && . "$HOME/.nvm/nvm.sh" && nvm use default >/dev/null 2>&1 || true
fi
command -v pi >/dev/null || { echo "pi not found. Run install.sh." >&2; exit 1; }

# Strip the YAML frontmatter; the body is the system prompt.
SYSTEM="$(awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; next} n>=2' "$SYSFILE")"

# System prompt mode differs by tier:
#   SIMPLE      -> replace. The local model is latency-bound; processing pi's large
#                  default prompt doubles the run time on an 8B model (measured
#                  136s -> 58s). Qwen3 emits native tool_calls, so that scaffolding
#                  is not needed.
#   MEDIUM/HARD -> append. Strong models are quality-bound, not latency-bound;
#                  keep pi's file-editing and project-context discipline.
# -ne disables extension discovery. pi-lens indexes the whole project on
# startup and hangs for minutes on a large codebase: on a 5,200-file Laravel
# project the same task took 7s with -ne and had not finished after 5 minutes
# without it. Delegated runs must be predictable, so extensions stay off.
if [[ "$AGENT" == "local-coder" ]]; then
  ARGS=(-p -ne --no-session --model "$MODEL" --thinking "$THINK" --system-prompt "$SYSTEM")
else
  ARGS=(-p -ne --no-session --model "$MODEL" --thinking "$THINK" --append-system-prompt "$SYSTEM")
fi
[[ -n "$TOOLS" ]] && ARGS+=(--tools "$TOOLS")

if [[ $DRY -eq 1 ]]; then
  printf 'cwd=%s\nmodel=%s thinking=%s agent=%s tools=%s\n' "$CWD" "$MODEL" "$THINK" "$AGENT" "${TOOLS:-<all>}"
  exit 0
fi

printf '\033[2m[orchestra] %s → %s (thinking=%s)\033[0m\n' "$AGENT" "$MODEL" "$THINK" >&2
cd "$CWD"

# The local model tends to normalize code style beyond the requested change.
# Printing the diff automatically keeps that from slipping past the orchestrator.
IS_GIT=0; git rev-parse --git-dir >/dev/null 2>&1 && IS_GIT=1
if [[ $IS_GIT -eq 0 ]]; then
  printf '\033[33m[orchestra] not a git repository: no diff will be shown and there is no way to\n' >&2
  printf '            revert what the delegated model writes. Run: git init && git add -A && git commit\033[0m\n' >&2
fi

# pi prints nothing until the run finishes and applies no request timeout of its
# own. Two failure modes look identical to a caller watching a silent terminal:
# a dropped connection leaves pi waiting forever with no open socket, and a cold
# Ollama model load keeps it quiet for minutes while it is working fine. So run
# pi under a watchdog that reports progress and kills only a provably stuck run.
#
#   ORCHESTRA_TIMEOUT        hard ceiling for one run              (default 1800)
#   ORCHESTRA_STALL_TIMEOUT  seconds with no network connection    (default 120)
#   ORCHESTRA_HEARTBEAT      progress line interval, 0 disables    (default 20)
TIMEOUT="${ORCHESTRA_TIMEOUT:-1800}"
STALL="${ORCHESTRA_STALL_TIMEOUT:-120}"
HEARTBEAT="${ORCHESTRA_HEARTBEAT:-20}"

set +e
pi "${ARGS[@]}" "$TASK" &
PI_PID=$!

VERDICT=""
ELAPSED=0; STALLED=0; STEP=5
while kill -0 "$PI_PID" 2>/dev/null; do
  sleep "$STEP"
  kill -0 "$PI_PID" 2>/dev/null || break
  ELAPSED=$((ELAPSED + STEP))

  # No open socket means the provider connection is gone. Tool calls close it
  # briefly, so only a sustained absence counts as stuck.
  if [[ "$STALL" -gt 0 ]]; then
    if [[ "$(lsof -nP -p "$PI_PID" 2>/dev/null | grep -c TCP)" -eq 0 ]]; then
      STALLED=$((STALLED + STEP))
    else
      STALLED=0
    fi
    [[ "$STALLED" -ge "$STALL" ]] && { VERDICT="stalled"; break; }
  fi

  [[ "$TIMEOUT" -gt 0 && "$ELAPSED" -ge "$TIMEOUT" ]] && { VERDICT="timeout"; break; }

  if [[ "$HEARTBEAT" -gt 0 && $((ELAPSED % HEARTBEAT)) -eq 0 ]]; then
    printf '\033[2m[orchestra] %ss… still working (pi prints its answer only at the end)\033[0m\n' "$ELAPSED" >&2
  fi
done

if [[ -n "$VERDICT" ]]; then
  kill -TERM "$PI_PID" 2>/dev/null
  sleep 2
  kill -KILL "$PI_PID" 2>/dev/null
  wait "$PI_PID" 2>/dev/null
  PI_STATUS=124
  if [[ "$VERDICT" == "stalled" ]]; then
    printf '\n\033[31m[orchestra] no network connection for %ss — the request died, pi killed.\n' "$STALL" >&2
    printf '            Check your connection and run the same command again.\033[0m\n' >&2
  else
    printf '\n\033[31m[orchestra] timed out after %ss — pi killed.\n' "$TIMEOUT" >&2
    printf '            Split the task, or raise ORCHESTRA_TIMEOUT.\033[0m\n' >&2
  fi
else
  wait "$PI_PID"
  PI_STATUS=$?
fi
set -e

if [[ $IS_GIT -eq 1 ]]; then
  CHANGED="$(git diff --stat 2>/dev/null | tail -1)"
  if [[ -n "$CHANGED" ]]; then
    printf '\n\033[1m[orchestra] changes:\033[0m %s\n' "$CHANGED" >&2
    git --no-pager diff >&2
    printf '\033[2m[orchestra] revert anything outside the requested change: git checkout -p <file>\033[0m\n' >&2
  else
    printf '\n\033[33m[orchestra] no files were changed.\033[0m\n' >&2
  fi
fi

exit $PI_STATUS
